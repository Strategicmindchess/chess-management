# Copy this file to .env and fill in real values.

# PostgreSQL connection string
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smc_crm?schema=public"

# Secret key used to sign access-token JWTs (min 32 characters).
# Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-this-with-a-long-random-secret-value"

# Base URL of this app (no trailing slash). Used to build the Google OAuth
# redirect URI and links inside emails.
APP_URL="http://localhost:3000"

# Used once by prisma/seed.ts to create the first Super Admin.
ADMIN_NAME="Super Admin"
ADMIN_EMAIL="admin@strategicmindchess.com"
ADMIN_PASSWORD="ChangeMe@123"

# --- Email (used to send signup/password-reset OTP codes) ---------------
# If left unset, OTP codes are logged to the server console instead of
# emailed, so the app stays usable without an SMTP provider configured yet.
# Any standard SMTP provider works (Gmail, SendGrid, Mailtrap, Resend SMTP...).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Strategic Mind Chess <no-reply@strategicmindchess.com>"

# --- Google OAuth (Sign in / Sign up with Google) ------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: {APP_URL}/api/auth/google/callback
# If left unset, the "Continue with Google" button shows a friendly error.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
