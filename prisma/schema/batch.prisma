/// A recurring class batch created by an Admin/Management user.
model Batch {
  id             String            @id @default(cuid())
  name           String
  code           String            @unique
  meetLink       String
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  coachProfileId String?
  payoutRate     Int               @default(0)
  startDate      DateTime?
  type           BatchType         @default(GROUP_SESSION)
  level          BatchLevel?
  /// 1-based: the session number the syllabus starts from for this batch
  startSession   Int?              @default(1)
  assignments    BatchAssignment[]
  schedules      BatchSchedule[]
  students       BatchStudent[]
  coach          CoachProfile?     @relation("BatchCoach", fields: [coachProfileId], references: [id])
  classInstances ClassInstance[]
  classLogs      ClassLog[]

  @@map("batches")
}

model ClassInstance {
  id            String      @id @default(cuid())
  batchId       String
  date          DateTime
  startTime     String
  endTime       String
  status        ClassStatus @default(SCHEDULED)
  classLogId    String?     @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lectureName   String?
  /// 1-based session number matching the syllabus (e.g. 4 = "Lecture 4")
  sessionNumber Int?
  /// Set when teacher marks class as held — anchor for the 24-hour assignment release timer
  completedAt   DateTime?
  batch         Batch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  classLog      ClassLog?   @relation(fields: [classLogId], references: [id])

  @@index([batchId, date])
  @@map("class_instances")
}

model BatchSchedule {
  id        String  @id @default(cuid())
  batchId   String
  day       Weekday
  startTime String
  endTime   String
  batch     Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, day, startTime])
  @@map("batch_schedules")
}

model BatchStudent {
  id               String         @id @default(cuid())
  batchId          String
  joinedAt         DateTime       @default(now())
  studentProfileId String
  batch            Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student          StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentProfileId])
  @@map("batch_students")
}

model CoachAvailability {
  id        String       @id @default(cuid())
  coachId   String
  startTime String
  endTime   String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  date      DateTime
  coach     CoachProfile @relation("CoachAvailability", fields: [coachId], references: [id], onDelete: Cascade)

  @@unique([coachId, date, startTime, endTime])
  @@map("coach_availability")
}

model ClassLog {
  id             String             @id @default(cuid())
  batchId        String
  coachProfileId String
  date           DateTime
  topicCovered   String
  durationMins   Int
  payoutAmount   Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  attendance     AttendanceRecord[]
  classInstance  ClassInstance?
  batch          Batch              @relation(fields: [batchId], references: [id], onDelete: Cascade)
  coach          CoachProfile       @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)

  @@map("class_logs")
}

model AttendanceRecord {
  id               String           @id @default(cuid())
  classLogId       String
  studentProfileId String
  status           AttendanceStatus
  classLog         ClassLog         @relation(fields: [classLogId], references: [id], onDelete: Cascade)
  student          StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([classLogId, studentProfileId])
  @@map("attendance_records")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ClassStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum BatchType {
  RECURRING
  DEMO
  TRIAL
  PTM
  REPLACEMENT
  GROUP_SESSION
  ONE_ON_ONE_SESSION
  DEMO_SESSION
  SUBSTITUTE_SESSION
  MASTERCLASS
}

enum BatchLevel {
  BEGINNER
  CORE_1
  CORE_2
  CORE_3
  CORE_4
  BRIDGE
  INTERMEDIATE_1
  INTERMEDIATE_2
  INTERMEDIATE_3
  ADVANCE_1
  ADVANCE_2
  ELITE
}
