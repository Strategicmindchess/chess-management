/// A recurring class batch created by an Admin/Management user.
model Batch {
  id             String            @id @default(cuid())
  name           String
  code           String            @unique
  meetLink       String
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  coachProfileId String?
  payoutRate     Int               @default(0)
  startDate      DateTime?
  type           BatchType         @default(GROUP_SESSION)
  level          BatchLevel?
  /// 1-based: the session number the syllabus starts from for this batch
  startSession   Int?              @default(1)
  assignments    BatchAssignment[]
  schedules      BatchSchedule[]
  students       BatchStudent[]
  coach          CoachProfile?     @relation("BatchCoach", fields: [coachProfileId], references: [id])
  classInstances ClassInstance[]
  classLogs      ClassLog[]

  @@map("batches")
}

model ClassInstance {
  id            String      @id @default(cuid())
  batchId       String
  date          DateTime
  startTime     String
  endTime       String
  status        ClassStatus @default(SCHEDULED)
  classLogId    String?     @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lectureName   String?
  /// 1-based session number matching the syllabus (e.g. 4 = "Lecture 4")
  sessionNumber Int?
  /// Set when teacher marks class as held — anchor for the 24-hour assignment release timer
  completedAt   DateTime?
  batch         Batch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  classLog      ClassLog?   @relation(fields: [classLogId], references: [id])
  rescheduleRequests CoachRescheduleRequest[]

  @@index([batchId, date])
  @@map("class_instances")
}

model BatchSchedule {
  id        String  @id @default(cuid())
  batchId   String
  day       Weekday
  startTime String
  endTime   String
  batch     Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, day, startTime])
  @@map("batch_schedules")
}

model BatchStudent {
  id               String         @id @default(cuid())
  batchId          String
  joinedAt         DateTime       @default(now())
  studentProfileId String
  batch            Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student          StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentProfileId])
  @@map("batch_students")
}

model CoachAvailability {
  id        String       @id @default(cuid())
  coachId   String
  startTime String
  endTime   String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  date      DateTime
  coach     CoachProfile @relation("CoachAvailability", fields: [coachId], references: [id], onDelete: Cascade)

  @@unique([coachId, date, startTime, endTime])
  @@map("coach_availability")
}

model ClassLog {
  id             String   @id @default(cuid())
  batchId        String
  coachProfileId String
  date           DateTime
  topicCovered   String
  durationMins   Int
  payoutAmount   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// When coach clicked Join — used to calculate late-join penalty
  coachJoinedAt      DateTime?
  /// When coach clicked Mark Held — used for attendance delay penalty (24h rule)
  attendanceMarkedAt DateTime?
  /// Total penalty amount deducted from this class's payout
  penaltyAmount        Int       @default(0)
  /// If admin waived the penalty for this class
  penaltyWaived        Boolean   @default(false)
  /// Set to true if an admin manually edits the penalty amount (worker will ignore this log)
  adminPenaltyOverride Boolean   @default(false)
  /// True if a phone usage penalty was applied to this class (used for historical tracking)
  hasPhonePenalty      Boolean   @default(false)
  /// Timestamp when the background worker finalized the penalty. (null = pending)
  penaltyCalculatedAt  DateTime?
  /// Admin note when waiving or manually applying penalty
  penaltyNote          String?

  attendance     AttendanceRecord[]
  classFeedbacks ClassFeedback[]
  classInstance  ClassInstance?
  batch          Batch              @relation(fields: [batchId], references: [id], onDelete: Cascade)
  coach          CoachProfile       @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)

  @@map("class_logs")
}

/// Student submits this immediately after class ends — triggers penalty calculation
model ClassFeedback {
  id                  String         @id @default(cuid())
  classLogId          String
  studentProfileId    String
  /// Did coach keep camera OFF for more than 5 min?
  cameraOffOver5Min   Boolean        @default(false)
  /// Did coach use phone more than 4 times?
  phoneUsedOver4Times Boolean        @default(false)
  /// Class quality score 1–10
  classQualityScore   Int?
  /// Did student understand the concept?
  conceptUnderstood   Boolean        @default(true)
  /// Overall coach performance score 1–10
  overallCoachScore   Int?
  submittedAt         DateTime       @default(now())
  classLog            ClassLog       @relation(fields: [classLogId], references: [id], onDelete: Cascade)
  student             StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([classLogId, studentProfileId])
  @@map("class_feedbacks")
}

/// Per-coach payout rate: how much per session for each batch level + duration
model CoachPayoutRate {
  id             String       @id @default(cuid())
  coachProfileId String
  level          BatchLevel
  durationMins   Int /// 30 | 40 | 45 | 50 | 60
  ratePerSession Int /// ₹ amount
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  coach          CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)

  @@unique([coachProfileId, level, durationMins])
  @@map("coach_payout_rates")
}

/// Manual bonus / incentive / deduction added by admin on top of payout
model PayoutAdjustment {
  id             String         @id @default(cuid())
  coachProfileId String
  month          String /// "2026-08"
  type           AdjustmentType
  amount         Int /// positive = add, negative = deduct
  reason         String /// Short note from admin
  createdAt      DateTime       @default(now())
  coach          CoachProfile   @relation(fields: [coachProfileId], references: [id], onDelete: Cascade)

  @@map("payout_adjustments")
}

enum AdjustmentType {
  BONUS
  INCENTIVE
  DEDUCTION
}

model AttendanceRecord {
  id               String           @id @default(cuid())
  classLogId       String
  studentProfileId String
  status           AttendanceStatus
  classLog         ClassLog         @relation(fields: [classLogId], references: [id], onDelete: Cascade)
  student          StudentProfile   @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([classLogId, studentProfileId])
  @@map("attendance_records")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  HOLIDAY
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ClassStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum BatchType {
  RECURRING
  DEMO
  TRIAL
  PTM
  REPLACEMENT
  GROUP_SESSION
  ONE_ON_ONE_SESSION
  DEMO_SESSION
  SUBSTITUTE_SESSION
  MASTERCLASS
}

enum BatchLevel {
  BEGINNER
  CORE_1
  CORE_2
  CORE_3
  CORE_4
  BRIDGE
  INTERMEDIATE_1
  INTERMEDIATE_2
  INTERMEDIATE_3
  ADVANCE_1
  ADVANCE_2
  ELITE
}

// ── Coach Rescheduling Request ─────────────────────────────────────────

/// Coach submits to request a class reschedule.
/// First 2 approved per coach per month: no penalty.
/// 3rd+ approved: admin may store a penalty amount (shown in management dashboard, stored in DB).
model CoachRescheduleRequest {
  id              String                  @id @default(cuid())
  classInstanceId String
  coachProfileId  String
  reason          String
  proposedDate    DateTime
  proposedStartTime String
  proposedEndTime   String
  status          RescheduleRequestStatus @default(PENDING)

  /// Admin who reviewed this request
  reviewedById   String?
  reviewedAt     DateTime?
  rejectionReason String?

  /// Penalty amount stored in DB (shown in management session, not auto-deducted)
  penaltyAmount  Int     @default(0)
  penaltyReason  String?

  /// If admin assigns a different coach instead of rescheduling
  replacementCoachId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classInstance    ClassInstance  @relation(fields: [classInstanceId], references: [id], onDelete: Cascade)
  coach            CoachProfile   @relation("CoachRescheduleRequests", fields: [coachProfileId], references: [id], onDelete: Cascade)
  reviewedBy       User?          @relation("AdminRescheduleReviews", fields: [reviewedById], references: [id])
  replacementCoach CoachProfile?  @relation("ReplacementCoachRequests", fields: [replacementCoachId], references: [id])

  @@index([coachProfileId, status])
  @@index([classInstanceId])
  @@index([status, createdAt])
  @@map("coach_reschedule_requests")
}

enum RescheduleRequestStatus {
  PENDING
  APPROVED
  APPROVED_WITH_PENALTY
  REJECTED
}
