/// Employee or Freelancer profile — separate from CoachProfile
/// Used for non-teaching staff with fixed salary / per-project payment
/// userId is optional — employees don't need a platform login
model EmployeeProfile {
  id             String               @id @default(cuid())
  userId         String?              @unique  /// Optional — if they have a platform account
  name           String               /// Employee full name
  phone          String?
  email          String?
  jobRole        String               /// e.g. "Operations Manager", "Content Writer"
  employeeType   EmployeeType         @default(FULL_TIME)
  employmentMode EmployeeMode         @default(EMPLOYEE)
  /// Fixed monthly salary (for EMPLOYEE type)
  fixedSalary    Float                @default(0)
  /// Per-project / per-task rate (for FREELANCER type)
  projectRate    Float                @default(0)
  tdsApplicable  Boolean              @default(false)
  joiningDate    DateTime?
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendance     EmployeeAttendance[]
  incentives     EmployeeIncentive[]

  @@map("employee_profiles")
}


/// Daily attendance record for employees
model EmployeeAttendance {
  id                String             @id @default(cuid())
  employeeProfileId String
  date              DateTime           /// The date of attendance (date only, time 00:00)
  status            AttendanceStatus   @default(PRESENT)
  checkInTime       String?            /// HH:mm format
  checkOutTime      String?            /// HH:mm format
  workingHours      Float?             /// Auto-calculated or manual
  isOvertime        Boolean            @default(false)
  overtimeHours     Float?
  overtimeBonus     Float              @default(0)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  employee          EmployeeProfile    @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@unique([employeeProfileId, date])
  @@map("employee_attendance")
}

/// Manual incentives / deductions / bonuses for employees
model EmployeeIncentive {
  id                String           @id @default(cuid())
  employeeProfileId String
  month             String           /// "2026-08"
  type              IncentiveType
  amount            Float
  reason            String
  createdAt         DateTime         @default(now())

  employee          EmployeeProfile  @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@map("employee_incentives")
}

enum EmployeeType {
  FULL_TIME
  PART_TIME
}

enum EmployeeMode {
  EMPLOYEE
  FREELANCER
  EMPLOYER
}




enum IncentiveType {
  BONUS
  INCENTIVE
  DEDUCTION
  ADVANCE
}
