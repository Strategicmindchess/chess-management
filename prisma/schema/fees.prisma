/// Fee configuration for a student. One record per student.
/// `feeType` is the billing model:
///   MONTHLY     → student pays on a recurring time schedule
///   BATCH_BASED → student pays once per completed batch (admin fills details manually)
model StudentFeeConfig {
  id               String @id @default(cuid())
  studentProfileId String @unique

  /// MONTHLY or BATCH_BASED — chosen by admin once, drives both UI and cycle creation
  feeType FeeType @default(MONTHLY)

  /// Default fee amount per cycle (₹). Admin can override per-cycle in FeeCycle.amount.
  feeAmount Int @default(0)

  /// For MONTHLY students: how many classes are included per cycle
  classesPerCycle Int @default(8)

  /// For MONTHLY students: the recurring billing interval
  frequency FeeFrequency @default(MONTHLY)

  /// Date the student started attending classes
  startDate DateTime?

  /// Date from which the first fee cycle is due (MONTHLY students)
  feeStartDate DateTime?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  cycles  FeeCycle[]

  @@map("student_fee_configs")
}

/// A single payment cycle for a student.
///
/// MONTHLY students:  dueDate + classes + amount
/// BATCH_BASED students: batchCode + batchName + amount
///   (batchId FK to Batch is Phase 2 — left null for now)
model FeeCycle {
  id          String @id @default(cuid())
  feeConfigId String

  // ── BATCH_BASED fields ──────────────────────────────────────────────────────
  /// Batch code filled manually by admin e.g. "B-14"  (null for MONTHLY cycles)
  batchCode String?
  /// Batch name filled manually by admin e.g. "Core 2 Group A" (null for MONTHLY)
  batchName String?

  // ── MONTHLY fields ───────────────────────────────────────────────────────────
  /// Calendar due date for time-based cycles (null for BATCH_BASED cycles)
  dueDate DateTime?
  /// Number of classes in this cycle (null for BATCH_BASED)
  classes Int?

  // ── Common fields ────────────────────────────────────────────────────────────
  /// Actual amount for this cycle (₹) — admin can differ from the config default
  amount    Int       @default(0)
  status    FeeStatus @default(UNPAID)
  paidDate  DateTime?
  notes     String?
  isHidden  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  feeConfig StudentFeeConfig @relation(fields: [feeConfigId], references: [id], onDelete: Cascade)

  @@index([feeConfigId])
  @@map("fee_cycles")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

/// Controls the billing model for a student
enum FeeType {
  MONTHLY /// Time-based billing (weekly / monthly / quarterly etc.)
  BATCH_BASED /// Pay once per completed batch — admin fills details manually
}

/// Billing interval for MONTHLY students
enum FeeFrequency {
  CLASS_WISE
  WEEKLY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

/// Payment status of a single fee cycle
enum FeeStatus {
  PAID
  UNPAID
  WAIVED
}
