/// A platform user. `role` determines which dashboard and permissions apply.
model User {
  id                     String                   @id @default(cuid())
  name                   String
  email                  String                   @unique
  passwordHash           String?
  role                   Role
  phone                  String?
  isActive               Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  emailVerified          Boolean                  @default(false)
  googleId               String?                  @unique
  profilePictureUrl      String?
  coachLeaderboardAwards CoachLeaderboardEntry[]  @relation("AdminLeaderboardAwards")
  coachProfile           CoachProfile?
  adminRescheduleReviews CoachRescheduleRequest[] @relation("AdminRescheduleReviews")
  employeeProfile        EmployeeProfile?
  notifications          Notification[]           @relation("UserNotifications")
  otpCodes               OtpCode[]
  refreshTokens          RefreshToken[]
  studentProfile         StudentProfile?
  ticketReplies          TicketReply[]
  assignedTickets        Ticket[]                 @relation("AssignedTickets")

  @@map("users")
}

model StudentProfile {
  id                    String                    @id @default(cuid())
  userId                String                    @unique
  parentName            String?
  parentPhone           String?
  city                  String?
  chessComId            String?
  lichessId             String?
  joiningDate           DateTime?
  assignedCoachId       String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  chessComRating        Int?
  lichessRating         Int?
  fideId                String?
  fideRating            Int?
  level                 StudentLevel?
  assignmentScores      AssignmentScore[]
  chessAccount          ChessAccount?
  activitySnapshots     ChessActivitySnapshot[]
  chessApiFetchLogs     ChessApiFetchLog[]
  coachFeedbackReceived CoachFeedback[]           @relation("StudentFeedback")
  fairPlayViolations    FairPlayViolation[]
  leaderboardEntries    LeaderboardEntry[]
  leaderboardRewards    LeaderboardReward[]
  puzzleSolverAwards    PuzzleSolverAward[]
  stats                 StudentChessStats?
  syncRuns              StudentSyncRun[]
  tournamentScores      TournamentScore[]         @relation("StudentTournament")
  attendanceRecords     AttendanceRecord[]
  enrollments           BatchStudent[]
  chocolateEligibility  ChocolateEligibility[]    @relation("StudentChocolateEligibility")
  chocolateQuestions    ChocolateQuestionRecord[] @relation("StudentChocolateQuestions")
  classFeedbacks        ClassFeedback[]
  leaderboardAttendance LeaderboardAttendance[]
  assignments           StudentAssignment[]
  feeConfig             StudentFeeConfig?
  assignedCoach         CoachProfile?             @relation("StudentAssignedCoach", fields: [assignedCoachId], references: [id])
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdTickets        Ticket[]                  @relation("CreatedTickets")

  @@map("student_profiles")
}

model CoachProfile {
  id                    String                    @id @default(cuid())
  userId                String                    @unique
  bio                   String?
  experience            String?
  city                  String?
  chessComId            String?
  lichessId             String?
  chessComRating        Int?
  lichessRating         Int?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  /// Employment type — Coach | Employee | Freelancer
  employmentType        EmploymentType            @default(COACH)
  /// TDS deduction applicable? Admin sets this.
  tdsApplicable         Boolean                   @default(false)
  coachFeedbackGiven    CoachFeedback[]           @relation("CoachGivenFeedback")
  tournamentScoresGiven TournamentScore[]         @relation("CoachTournament")
  batches               Batch[]                   @relation("BatchCoach")
  chocolateQuestions    ChocolateQuestionRecord[] @relation("CoachChocolateQuestions")
  joinEvents            ClassJoinEvent[]
  classLogs             ClassLog[]
  availabilities        CoachAvailability[]       @relation("CoachAvailability")
  leaderboardEntries    CoachLeaderboardEntry[]   @relation("CoachLeaderboard")
  payoutRates           CoachPayoutRate[]
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rescheduleRequests    CoachRescheduleRequest[]  @relation("CoachRescheduleRequests")
  replacementRequests   CoachRescheduleRequest[]  @relation("ReplacementCoachRequests")
  payoutAdjustments     PayoutAdjustment[]
  assignedStudents      StudentProfile[]          @relation("StudentAssignedCoach")
  tickets               Ticket[]                  @relation("CoachCreatedTickets")

  @@map("coach_profiles")
}

enum EmploymentType {
  COACH
  EMPLOYEE
  FREELANCER
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum StudentLevel {
  BEGINNER
  CORE_1
  CORE_2
  CORE_3
  CORE_4
  INTERMEDIATE_1
  INTERMEDIATE_2
  INTERMEDIATE_3
  ADVANCE_1
  ADVANCE_2
  ELITE
}
