/// A platform user. `role` determines which dashboard and permissions apply.
model User {
  id                String          @id @default(cuid())
  name              String
  email             String          @unique
  passwordHash      String?
  role              Role
  phone             String?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  emailVerified     Boolean         @default(false)
  googleId          String?         @unique
  profilePictureUrl String?
  coachProfile      CoachProfile?
  otpCodes          OtpCode[]
  refreshTokens     RefreshToken[]
  studentProfile    StudentProfile?
  ticketReplies     TicketReply[]
  assignedTickets   Ticket[]        @relation("AssignedTickets")

  @@map("users")
}

model StudentProfile {
  id                    String                  @id @default(cuid())
  userId                String                  @unique
  parentName            String?
  parentPhone           String?
  city                  String?
  chessComId            String?
  chessComRating        Int?
  lichessId             String?
  lichessRating         Int?
  joiningDate           DateTime?
  assignedCoachId       String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  fideId                String?
  fideRating            Int?
  level                 StudentLevel?
  assignmentScores      AssignmentScore[]
  chessAccount          ChessAccount?
  activitySnapshots     ChessActivitySnapshot[]
  chessApiFetchLogs     ChessApiFetchLog[]
  coachFeedbackReceived CoachFeedback[]         @relation("StudentFeedback")
  fairPlayViolations    FairPlayViolation[]
  leaderboardEntries    LeaderboardEntry[]
  leaderboardRewards    LeaderboardReward[]
  puzzleSolverAwards    PuzzleSolverAward[]
  tournamentScores      TournamentScore[]       @relation("StudentTournament")
  attendanceRecords     AttendanceRecord[]
  enrollments           BatchStudent[]
  leaderboardAttendance LeaderboardAttendance[]
  assignments           StudentAssignment[]
  syncRuns              StudentSyncRun[]
  assignedCoach         CoachProfile?           @relation("StudentAssignedCoach", fields: [assignedCoachId], references: [id])
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  stats                 StudentChessStats?
  createdTickets        Ticket[]                @relation("CreatedTickets")

  @@map("student_profiles")
}

model CoachProfile {
  id                    String              @id @default(cuid())
  userId                String              @unique
  bio                   String?
  experience            String?
  city                  String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  chessComId            String?
  chessComRating        Int?
  lichessId             String?
  lichessRating         Int?
  coachFeedbackGiven    CoachFeedback[]     @relation("CoachGivenFeedback")
  tournamentScoresGiven TournamentScore[]   @relation("CoachTournament")
  batches               Batch[]             @relation("BatchCoach")
  classLogs             ClassLog[]
  availabilities        CoachAvailability[] @relation("CoachAvailability")
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedStudents      StudentProfile[]    @relation("StudentAssignedCoach")

  @@map("coach_profiles")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum StudentLevel {
  BEGINNER
  CORE_1
  CORE_2
  CORE_3
  CORE_4
  INTERMEDIATE_1
  INTERMEDIATE_2
  INTERMEDIATE_3
  ADVANCE_1
  ADVANCE_2
  ELITE
}
