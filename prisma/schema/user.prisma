/// A platform user. `role` determines which dashboard and permissions apply.
model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  passwordHash   String?
  role           Role
  phone          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  emailVerified  Boolean         @default(false)
  googleId       String?         @unique
  coachProfile   CoachProfile?
  otpCodes       OtpCode[]
  refreshTokens  RefreshToken[]
  studentProfile StudentProfile?

  @@map("users")
}

model StudentProfile {
  id                String             @id @default(cuid())
  userId            String             @unique
  parentName        String?
  parentPhone       String?
  city              String?
  chessComId        String?
  lichessId         String?
  rating            Int?
  joiningDate       DateTime?
  monthlyFee        Int?
  perSessionFee     Int?
  assignedCoachId   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  attendanceRecords AttendanceRecord[]
  enrollments       BatchStudent[]
  assignedCoach     CoachProfile?      @relation("StudentAssignedCoach", fields: [assignedCoachId], references: [id])
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model CoachProfile {
  id               String              @id @default(cuid())
  userId           String              @unique
  bio              String?
  experience       String?
  city             String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  batches          Batch[]             @relation("BatchCoach")
  classLogs        ClassLog[]
  availabilities   CoachAvailability[] @relation("CoachAvailability")
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  rates            CoachRate?
  assignedStudents StudentProfile[]    @relation("StudentAssignedCoach")

  @@map("coach_profiles")
}

/// A coach's specific payout rates
model CoachRate {
  id               String       @id @default(cuid())
  coachId          String       @unique
  groupSessionRate Int          @default(0)
  privateRate      Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  coach            CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@map("coach_rates")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}
